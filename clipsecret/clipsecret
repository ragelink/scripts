#!/usr/bin/env bash
# clipsecret: move secrets between your clipboard and AWS Secrets Manager
# without the value ever appearing in your terminal, shell history, or logs.
#
#   clipsecret set  <secret-id> [json-key]   wait for a new value on the clipboard, store it
#   clipsecret copy <secret-id> [json-key]   put a stored value on the clipboard
#
# Run `clipsecret --help` for options. Needs bash 3.2+, python3 and the AWS CLI.
set -euo pipefail
umask 077

VERSION=1.0.0
PROG=${0##*/}
export AWS_PAGER=""

usage() {
  cat <<EOF
$PROG $VERSION - clipboard <-> AWS Secrets Manager, values never printed

Usage:
  $PROG set  <secret-id> [json-key] [options]
  $PROG copy <secret-id> [json-key] [options]

set   Start the command, then copy the new value (e.g. a freshly rotated
      client secret in a vendor console). $PROG waits for the clipboard to
      change, validates the value, writes it to the secret and clears the
      clipboard. With a json-key only that key of a JSON secret is replaced;
      without one the whole secret string is replaced.

copy  Put the secret (or one json-key of it) on the clipboard and print only
      its length. The clipboard is cleared after --clear-after seconds if it
      still holds the value.

Options:
  --profile NAME      AWS profile (default: \$AWS_PROFILE)
  --region NAME       AWS region (default: \$AWS_REGION / profile default)
  --timeout SECONDS   set: how long to wait for the clipboard (default 120)
  --min-length N      set: reject values shorter than N characters (default 16)
  --allow-whitespace  set: accept values with whitespace or invisible characters
  --create-key        set: allow adding a json-key that does not exist yet
  --stdin             set: read the value from a pipe instead of the clipboard
  --clear-after SECS  copy: clear the clipboard after SECS, 0 = never (default 60)
  --dry-run           read and validate, change nothing (set: no write;
                      copy: clipboard left alone)
  -h, --help          show this help
  -V, --version       show version

Examples:
  $PROG set  prod-secrets CLIENT_SECRET --profile acme
  $PROG copy prod-secrets API_TOKEN --clear-after 30
  $PROG set  my-plain-secret                  # non-JSON secret
  generate-token | $PROG set prod-secrets API_TOKEN --stdin
EOF
}

die() { echo "$PROG: $*" >&2; exit 1; }

# ---------- value handling ----------
# Every secret value is handled by this python helper, through 0600 files. It never
# prints a value, and reports unexpected exceptions by type only, because exception
# messages (decode errors, for one) can quote the data that caused them.
read -r -d '' PY <<'PYCODE' || true
import hashlib, json, sys, unicodedata

prog, cmd, args = sys.argv[1], sys.argv[2], sys.argv[3:]

def die(msg):
    sys.stderr.write("%s: %s\n" % (prog, msg))
    sys.exit(1)

def read(path):
    with open(path, "rb") as f:
        return f.read()

def write(path, text):
    with open(path, "wb") as f:
        f.write(text.encode("utf-8"))

def secret_string(path):
    # `--query SecretString --output json` prints the SecretString as a JSON string, or null
    try:
        s = json.loads(read(path).decode("utf-8"))
    except ValueError:
        die("could not parse the aws CLI output")
    if s is None:
        die("secret has no SecretString (binary secrets are not supported)")
    if not isinstance(s, str):
        die("unexpected aws CLI output")
    return s

def as_object(secret):
    try:
        data = json.loads(secret)
    except ValueError:
        data = None
    if not isinstance(data, dict):
        die("secret is not a JSON object; omit the json-key to use the whole secret string")
    return data

def text(v):
    return v if isinstance(v, str) else json.dumps(v)

def stored(secret, key):
    # the whole secret string, or one key of a JSON object (None when the key is absent)
    if not key:
        return secret
    data = as_object(secret)
    return text(data[key]) if key in data else None

def strings_in(raw):
    # raw file text, plus the strings it encodes: a JSON string, and a JSON object's values
    out = [raw]
    try:
        obj = json.loads(raw)
        if isinstance(obj, str):
            out.append(obj)
            obj = json.loads(obj)
    except ValueError:
        return out
    if isinstance(obj, dict):
        out.extend(text(v) for v in obj.values())
    return out

def main():
    if cmd == "fp":  # fp < DATA: sha256 of stdin
        print(hashlib.sha256(sys.stdin.buffer.read()).hexdigest())
    elif cmd == "extract":  # extract SECRET KEY OUT: write the value to OUT, print its length
        value = stored(secret_string(args[0]), args[1])
        if value is None:
            die("key %r not found in secret" % args[1])
        write(args[2], value)
        print(len(value))
    elif cmd == "prepare":  # prepare SECRET KEY CREATE: surface secret/key problems before waiting
        secret, key = secret_string(args[0]), args[1]
        if key and key not in as_object(secret):
            if args[2] != "1":
                die("key %r not in secret (use --create-key to add it)" % key)
            print("key %r does not exist yet; it will be added" % key)
    elif cmd == "check":  # check SECRET KEY CANDIDATE MIN_LEN ALLOW_WS: exit 0 and print length, or exit with a reason code
        try:
            v = read(args[2]).decode("utf-8")
        except UnicodeDecodeError:
            sys.exit(7)
        if v.endswith("\r\n"):  # tolerate one trailing newline
            v = v[:-2]
        elif v.endswith("\n"):
            v = v[:-1]
        if not v:
            sys.exit(6)
        if len(v) < int(args[3]):
            sys.exit(3)
        if args[4] != "1" and any(c.isspace() or unicodedata.category(c) in ("Cc", "Cf") for c in v):
            sys.exit(4)
        if v == stored(secret_string(args[0]), args[1]):
            sys.exit(5)
        write(args[2], v)
        print(len(v))
    elif cmd == "merge":  # merge SECRET KEY CANDIDATE OUT: write the new SecretString to OUT
        secret, key = secret_string(args[0]), args[1]
        value = read(args[2]).decode("utf-8")
        if key:
            data = as_object(secret)
            data[key] = value
            value = json.dumps(data, separators=(",", ":"))
        write(args[3], value)
    elif cmd == "scrub":  # scrub ERRFILE FILE...: copy ERRFILE to stderr with secret material masked
        needles = set()
        for path in args[1:]:
            try:
                raw = read(path).decode("utf-8")
            except (OSError, ValueError):
                continue
            for s in strings_in(raw):
                if len(s) >= 4:
                    needles.update((s, json.dumps(s)[1:-1]))
        msg = read(args[0]).decode("utf-8", "replace")
        for n in sorted(needles, key=len, reverse=True):
            msg = msg.replace(n, "[redacted]")
        sys.stderr.write(msg)
    else:
        die("internal error (unknown helper command)")

try:
    main()
except KeyboardInterrupt:
    sys.exit(130)
except Exception as e:
    sys.stderr.write("%s: internal error (%s)\n" % (prog, type(e).__name__))
    sys.exit(70)
PYCODE

py() { python3 -I -c "$PY" "$PROG" "$@"; }

# ---------- clipboard backends ----------
# Picked once. pbcopy/pbpaste run under a UTF-8 locale: without one they convert to
# MacRoman and corrupt non-ASCII values. wl-copy, xclip and xsel fork a process that
# owns the selection; it gets stdout/stderr on /dev/null so it cannot hold a caller's
# pipe open and hang `$(clipsecret copy ...)`.
CLIP=""
pick_clipboard() {  # pick_clipboard [hint]
  if command -v pbcopy >/dev/null 2>&1 && command -v pbpaste >/dev/null 2>&1; then CLIP=pb
  elif [ -n "${WAYLAND_DISPLAY:-}" ] && command -v wl-copy >/dev/null 2>&1 && command -v wl-paste >/dev/null 2>&1; then CLIP=wl
  elif [ -n "${DISPLAY:-}" ] && command -v xclip >/dev/null 2>&1; then CLIP=xclip
  elif [ -n "${DISPLAY:-}" ] && command -v xsel >/dev/null 2>&1; then CLIP=xsel
  else die "no usable clipboard: need pbcopy/pbpaste (macOS), wl-copy/wl-paste (Wayland), or xclip or xsel with DISPLAY set (X11)${1:+; $1}"
  fi
}
clip_read() {  # stdout: the clipboard text, empty when there is none
  case $CLIP in
    pb) LC_ALL=en_US.UTF-8 pbpaste ;;
    wl) wl-paste --no-newline 2>/dev/null || true ;;
    xclip) xclip -selection clipboard -o 2>/dev/null || true ;;
    xsel) xsel --clipboard --output 2>/dev/null || true ;;
  esac
}
clip_write() {  # stdin: the text to put on the clipboard
  case $CLIP in
    pb) LC_ALL=en_US.UTF-8 pbcopy ;;
    wl) wl-copy >/dev/null 2>&1 ;;
    xclip) xclip -selection clipboard -i >/dev/null 2>&1 ;;
    xsel) xsel --clipboard --input >/dev/null 2>&1 ;;
  esac
}
clip_clear() {
  case $CLIP in
    pb) printf '' | LC_ALL=en_US.UTF-8 pbcopy ;;
    wl) wl-copy --clear >/dev/null 2>&1 ;;
    xclip) printf '' | xclip -selection clipboard -i >/dev/null 2>&1 ;;
    xsel) xsel --clipboard --clear >/dev/null 2>&1 ;;
  esac
}
schedule_clear() {  # schedule_clear SECONDS FINGERPRINT: later, clear the clipboard if it still holds the value
  (
    trap '' HUP  # outlive a closing terminal, like nohup
    sleep "$1"
    [ "$(clip_read | py fp)" = "$2" ] && clip_clear
  ) </dev/null >/dev/null 2>&1 &
}

# ---------- arguments ----------
[ $# -ge 1 ] || { usage >&2; exit 1; }
case $1 in
  -h | --help) usage; exit 0 ;;
  -V | --version) echo "$PROG $VERSION"; exit 0 ;;
  set | copy) CMD=$1; shift ;;
  *) die "unknown command '$1' (expected set or copy; see --help)" ;;
esac

TIMEOUT=120 MIN_LEN=16 CLEAR_AFTER=60 ALLOW_WS=0 CREATE_KEY=0 USE_STDIN=0 DRY_RUN=0
AWS_ARGS=() POS=()
need() { [ $# -ge 2 ] || die "option $1 needs a value"; }
need_int() { need "$@"; case $2 in '' | *[!0-9]*) die "option $1 needs a whole number, got '$2'" ;; esac; }
while [ $# -gt 0 ]; do
  case $1 in
    --profile) need "$@"; AWS_ARGS+=(--profile "$2"); shift 2 ;;
    --region) need "$@"; AWS_ARGS+=(--region "$2"); shift 2 ;;
    --timeout) need_int "$@"; TIMEOUT=$((10#$2)); shift 2 ;;
    --min-length) need_int "$@"; MIN_LEN=$((10#$2)); shift 2 ;;
    --clear-after) need_int "$@"; CLEAR_AFTER=$((10#$2)); shift 2 ;;
    --allow-whitespace) ALLOW_WS=1; shift ;;
    --create-key) CREATE_KEY=1; shift ;;
    --stdin) USE_STDIN=1; shift ;;
    --dry-run) DRY_RUN=1; shift ;;
    -h | --help) usage; exit 0 ;;
    --) shift; POS+=("$@"); break ;;
    -*) die "unknown option '$1' (see --help)" ;;
    *) POS+=("$1"); shift ;;
  esac
done
case ${#POS[@]} in 1 | 2) ;; *) die "expected <secret-id> [json-key] (see --help)" ;; esac
SECRET_ID=${POS[0]}
KEY=${POS[1]:-}
[ -n "$SECRET_ID" ] || die "<secret-id> is empty"
LABEL=$SECRET_ID${KEY:+:$KEY}
[ "$TIMEOUT" -ge 1 ] || die "--timeout must be at least 1"
if [ "$USE_STDIN" = 1 ]; then
  [ "$CMD" = set ] || die "--stdin only applies to set"
  [ ! -t 0 ] || die "--stdin reads a pipe, not a terminal (e.g. generate-token | $PROG set ... --stdin)"
fi
command -v aws >/dev/null 2>&1 || die "aws CLI not found"
command -v python3 >/dev/null 2>&1 || die "python3 not found"
if [ "$CMD" = copy ]; then
  [ "$DRY_RUN" = 1 ] || pick_clipboard
elif [ "$USE_STDIN" = 0 ]; then
  pick_clipboard "or pipe the value in with --stdin"
fi

aws_() { aws ${AWS_ARGS[@]+"${AWS_ARGS[@]}"} "$@"; }

# AWS CLI history stores raw request and response bodies, i.e. the secret values.
if [ "$(aws_ configure get cli_history 2>/dev/null || true)" = enabled ]; then
  die "AWS CLI history (cli_history) is enabled for this profile and would record the secret value in ~/.aws/cli/history; disable it first: aws configure set cli_history disabled (with the same --profile)"
fi

TMPD=$(mktemp -d "${TMPDIR:-/tmp}/clipsecret.XXXXXX") || die "could not create a temporary directory"
trap 'rm -rf "$TMPD"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP
chmod 700 "$TMPD"

aws_ secretsmanager get-secret-value --secret-id "$SECRET_ID" \
  --query SecretString --output json >"$TMPD/secret.json" ||
  die "could not read secret '$SECRET_ID'"

# ---------- copy ----------
if [ "$CMD" = copy ]; then
  len=$(py extract "$TMPD/secret.json" "$KEY" "$TMPD/value") || exit 1
  if [ "$DRY_RUN" = 1 ]; then
    echo "dry run: $LABEL is readable (length $len); clipboard not touched"
    exit 0
  fi
  clip_write <"$TMPD/value" || die "could not write to the clipboard"
  echo "copied $LABEL to the clipboard (length $len)"
  if [ "$CLEAR_AFTER" -gt 0 ]; then
    schedule_clear "$CLEAR_AFTER" "$(py fp <"$TMPD/value")"
    echo "the clipboard will be cleared in ${CLEAR_AFTER}s if it still holds the value"
  fi
  exit 0
fi

# ---------- set ----------
note=$(py prepare "$TMPD/secret.json" "$KEY" "$CREATE_KEY") || exit 1
[ -z "$note" ] || echo "$note"

reason() {  # reason CODE: why `py check` rejected a value
  case $1 in
    3) echo "is shorter than $MIN_LEN characters (see --min-length)" ;;
    4) echo "contains whitespace or invisible characters (see --allow-whitespace)" ;;
    5) echo "is the value already stored; copy the NEW value" ;;
    6) echo "is empty" ;;
    7) echo "is not UTF-8 text" ;;
    *) return 1 ;;
  esac
}

if [ "$USE_STDIN" = 1 ]; then
  cat >"$TMPD/candidate"
  rc=0
  len=$(py check "$TMPD/secret.json" "$KEY" "$TMPD/candidate" "$MIN_LEN" "$ALLOW_WS") || rc=$?
  if [ "$rc" != 0 ]; then
    why=$(reason "$rc") || exit 1
    die "the value on stdin $why; nothing changed"
  fi
else
  before=$(clip_read | py fp)
  deadline=$((SECONDS + TIMEOUT))
  echo "waiting up to ${TIMEOUT}s: copy the new value now..."
  found=0
  while [ "$SECONDS" -lt "$deadline" ]; do
    clip_read >"$TMPD/candidate"
    now=$(py fp <"$TMPD/candidate")
    if [ "$now" != "$before" ]; then
      before=$now  # judge each clipboard change once
      rc=0
      len=$(py check "$TMPD/secret.json" "$KEY" "$TMPD/candidate" "$MIN_LEN" "$ALLOW_WS") || rc=$?
      if [ "$rc" = 0 ]; then found=1; break; fi
      why=$(reason "$rc") || exit 1
      echo "  the clipboard changed, but the value $why; still waiting..."
    fi
    sleep 1
  done
  [ "$found" = 1 ] || die "no valid value copied within ${TIMEOUT}s; nothing changed"
fi

py merge "$TMPD/secret.json" "$KEY" "$TMPD/candidate" "$TMPD/new" || exit 1
if [ "$DRY_RUN" = 1 ]; then
  echo "dry run: would update $LABEL (length $len); nothing written"
  exit 0
fi
if ! version=$(aws_ secretsmanager put-secret-value --secret-id "$SECRET_ID" \
  --secret-string "file://$TMPD/new" --query VersionId --output text 2>"$TMPD/aws.err"); then
  py scrub "$TMPD/aws.err" "$TMPD/secret.json" "$TMPD/new" "$TMPD/candidate" || true
  [ "$USE_STDIN" = 1 ] && die "failed to write secret '$SECRET_ID'; nothing changed"
  die "failed to write secret '$SECRET_ID'; nothing changed, and the new value is still on the clipboard"
fi
if [ "$USE_STDIN" = 1 ]; then
  echo "updated $LABEL (length $len) -> version $version"
elif clip_clear; then
  echo "updated $LABEL (length $len) -> version $version; clipboard cleared"
else
  echo "updated $LABEL (length $len) -> version $version"
  echo "$PROG: warning: could not clear the clipboard; clear it yourself" >&2
fi
